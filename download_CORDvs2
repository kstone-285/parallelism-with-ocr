from datasets import load_dataset
from tqdm import tqdm
import os

def download_all_cord_images():
    # 저장 경로
    save_dir = "dataset/training_data/images"
    os.makedirs(save_dir, exist_ok=True)
    
    print("CORD v2 데이터셋(Train) 전체 다운로드 시작...")
    
    # 스트리밍 모드로 로드
    dataset = load_dataset("naver-clova-ix/cord-v2", split="train", streaming=True)
    
    count = 0
    for data in tqdm(dataset):
        image = data['image']
        
        if image.mode != 'RGB':
            image = image.convert('RGB')
            
        filename = f"cord_train_{count:05d}.png"
        save_path = os.path.join(save_dir, filename)
        
        # 이미 파일이 있으면 건너뛰기 (중단 후 재실행 시 유용)
        if not os.path.exists(save_path):
            image.save(save_path)
        
        count += 1

    print(f"\n[완료] 총 {count}장의 이미지가 저장되었습니다.")

if __name__ == "__main__":
    download_all_cord_images()